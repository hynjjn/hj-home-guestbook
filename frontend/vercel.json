{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-ME.a.run.app/api/:path*" },
    { "source": "/media/:path*", "destination": "https://REPLACE-ME.a.run.app/media/:path*" }
  ]
}
